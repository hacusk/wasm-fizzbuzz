{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wasm-fizzbuzz",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
